PORT=5000
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# AI CHATBOT — Google Gemini  →  https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# WEATHER WIDGET  →  https://openweathermap.org/api  (free tier works)
# If empty, mock weather data is returned automatically.
# ─────────────────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# NEARBY SUPPLIERS (Google Places API)
# Get from: https://console.cloud.google.com/ → Enable "Places API"
# If empty, nearby_suppliers returns [] without crashing.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# AWS "SHIP IT" DEPLOYMENT — leave all of these unset for local dev.
# Set them as App Runner environment variables in production (never commit
# real values here). See DEPLOY.md for the full walkthrough.
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# Scans/fields history → S3 instead of local JSON files (App Runner's disk
# doesn't survive restarts). local | s3
STORAGE_BACKEND=local
S3_DATA_BUCKET=

# Leaf photo uploads → S3 (with optional CloudFront domain in front of it)
S3_UPLOADS_BUCKET=
CLOUDFRONT_UPLOADS_DOMAIN=

# Model weights (~230MB) are gitignored — downloaded from S3 on startup
MODELS_S3_BUCKET=

# Background retraining rewrites local .pkl files — off by default in
# production (ephemeral, multi-instance-unsafe). Fine to leave "true" locally.
ENABLE_AUTO_RETRAIN=true
